{
  "name": "lmsearch",
  "version": "1.1.0",
  "description": "",
  "main": "lmsearch.js",
  "scripts": {
    "start": "npm run prebuild-sass | run-p watch-js watch-sass",
    "watch-js": "vite build --watch --mode development",
    "watch-sass": "sass -w --load-path scss --load-path . scss/lmsearch-plugin.scss ../origo/plugins/lmsearch.css",
    "prebuild-sass": "sass --load-path scss --load-path . scss/lmsearch-plugin.scss ../origo/plugins/lmsearch.css",
    "build": "vite build && npm run build-sass",
    "build-sass": "sass --load-path scss --load-path . scss/lmsearch-plugin.scss build/css/lmsearch.css",
    "analyze": "vite build --mode analyze"
  },
  "author": "Johnny Blästa",
  "license": "MIT",
  "dependencies": {
    "awesomplete": "^1.1.7",
    "lodash": "^4.17.23"
  },
  "devDependencies": {
    "eslint": "^8.0.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "npm-run-all": "^4.1.5",
    "rollup-plugin-visualizer": "^6.0.4",
    "sass-embedded": "^1.98.0",
    "vite": "^7.1.5"
  }
}
